@* Passo 03 - Criar as Views *@
@* Se estou na view(index) de Produtos, qual sera a model 
que devo usar??*@
@model List<TechStoreMVC.Models.Produto>


@{
    ViewData[index: "Title"] = "Produtos";
}
<h1>
    Lista de Produtos
</h1>
<table class="table table-striped">
   <!-- Tipo da tabela acima com Boostrap -->
    <thead>
        <!-- Cabeçalho da tabela -->
        <tr>
        <th>Id</th>
        <th>Nome</th>
        <th>Preço</th>
        <th>Estoque</th>
        </tr>
    </thead>
</table>

    <!-- Imagine que a cada novo produto você tivesse que repetir isso 
    toda a vez, seriam linhas sem fim. Por isso, usamos o foreach. 

    O Foreach repete enquanto houver produtos existententes e, se
    existir, eles serão exibidos para ti nessa tela. -->
    <tbody>
    @foreach(var produto in Model)
    {
        <tr>
        <td>@produto.Id</td>
        <td>@produto.Nome</td>
        <td>R$ @produto.Preco.ToString(format: "F2")</td>
        <td>@produto.Estoque</td>
        <td>
           
           <a asp-action="Details" asp-route-id="produto.id" class= "btn btn-primary">
            |Details
           </a>
            <a asp-action="Create" asp-route-id="produto.id" class= "btn btn-primary">
            |Create
           </a>
            <a asp-action="Delete" asp-route-id="produto.id" class= "btn btn-primary">
            |Delete
           </a>
            <a asp-action="Edit" asp-route-id="produto.id" class= "btn btn-primary">
            |Edit
           </a>
        </td>
     </tr>
    }
</tbody>
